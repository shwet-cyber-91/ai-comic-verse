# Frontend configuration. All optional: the defaults just work.

# Only needed when the API is NOT on the same origin. In `npm run dev` the Vite
# proxy already forwards /api and /static to http://127.0.0.1:8000, so leave this
# empty for local development.
# VITE_API_BASE=http://localhost:8000

# Where `npm run dev` proxies /api and /static to.
# VITE_BACKEND_URL=http://127.0.0.1:8000
