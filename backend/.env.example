# ============================================================================
# AI ComicVerse - backend configuration
# Copy to .env and add your Gemini API key for real story analysis.
# ============================================================================

# --- Server ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Storage --------------------------------------------------------------
# STORAGE_DIR=./storage

# --- Database -------------------------------------------------------------
# SQLite (default) needs nothing. For Postgres set USE_SQLITE=false.
USE_SQLITE=true
# DATABASE_URL=postgresql+psycopg2://comicverse:comicverse@localhost:5432/comicverse
POSTGRES_USER=comicverse
POSTGRES_PASSWORD=comicverse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=comicverse

# --- Story understanding / dialogue / camera (LLM) -------------------------
# mock | gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Image generation -----------------------------------------------------
# mock | replicate | gemini | pollinations
IMAGE_PROVIDER=pollinations
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
# JSON with {prompt} {negative_prompt} {image} {seed} {aspect_ratio} placeholders.
# Leave empty to use the built-in mapping for the model above.
REPLICATE_INPUT_TEMPLATE=
IMAGE_SIZE=768
IMAGE_STEPS=28
IMAGE_GUIDANCE=3.5
# Hard cap on how long to poll a single Replicate prediction (seconds)
REPLICATE_TIMEOUT=180

# --- Voice to text --------------------------------------------------------
# mock | faster_whisper | openai
STT_PROVIDER=mock
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
OPENAI_API_KEY=
# Text returned by the mock transcriber when no <audio>.txt sidecar exists.
MOCK_TRANSCRIPT=

# --- Character memory -----------------------------------------------------
# auto | clip | fallback      (auto = clip when torch+open_clip import cleanly)
EMBEDDING_BACKEND=auto
# auto | chroma | json        (auto = chroma when importable, else json)
VECTOR_STORE=auto
# CHROMA_DIR=./storage/chroma

# --- Continuity checker ---------------------------------------------------
CONTINUITY_THRESHOLD=0.62
CONTINUITY_MAX_RETRIES=2
# Weight of CLIP similarity vs colour-histogram score (rest goes to colour)
CONTINUITY_CLIP_WEIGHT=0.65

# --- Generation defaults --------------------------------------------------
DEFAULT_PANEL_COUNT=8
PANELS_PER_PAGE=4
SEED=42

# --- Behaviour ------------------------------------------------------------
# true  -> configured-but-uncredentialed provider raises at startup
# false -> falls back to mock and logs a warning
STRICT_PROVIDERS=false
